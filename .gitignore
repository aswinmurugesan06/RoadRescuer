# =============================================================================
# RoadRescuer Root .gitignore
# Excludes environment secrets, dependencies, build artifacts, IDE & OS files
# =============================================================================

# ── Environment & Secret Files ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*serviceAccountKey*.json
*credentials*.json

# ── Node.js / Backend ────────────────────────────────────────────────────────
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Flutter / Dart / Mobile ─────────────────────────────────────────────────
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/ios/Flutter/.last_build_id
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Podfile.lock
mobile/linux/flutter/ephemeral/
mobile/windows/flutter/ephemeral/
mobile/macos/flutter/ephemeral/
mobile/.metadata

# Flutter Symbolication & Obfuscation
app.*.symbols
app.*.map.json
**/doc/api/

# ── Firebase local test config (fill in from Firebase Console) ───────────────
mobile/firebase_test_config.json

# Firebase CLI deploy cache
.firebase/

# ── Logs & Databases ─────────────────────────────────────────────────────────
*.log
*.sqlite
*.sqlite3
*.db

# ── IDEs & Code Editors ──────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Operating System Files ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── Temporary / Scratch Files ────────────────────────────────────────────────
*.swp
*.swo
*~
*.bak
*.tmp
.history
.buildlog/
.atom/
.svn/
