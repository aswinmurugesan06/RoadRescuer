# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/roadrescue_db?schema=public"

# Authentication Secrets
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_DEV_MODE=true

# Firebase Admin SDK (server-side FCM push notifications)
# Download a service account key from Firebase Console ->
# Project settings -> Service accounts -> Generate new private key.
# Either paste the whole JSON as one line into FIREBASE_SERVICE_ACCOUNT_KEY,
# or provide the three individual values below.
FIREBASE_PROJECT_ID=road-rescuer
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@road-rescuer.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
