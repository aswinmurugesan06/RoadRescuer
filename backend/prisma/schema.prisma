// Prisma schema file for RoadRescue backend
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderCategory {
  MECHANIC
  PUNCTURE
  TOW_TRUCK
  BATTERY
  FUEL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  SERVICE_VERIFICATION
}

enum RequestStatus {
  PENDING
  SEARCHING
  ACCEPTED
  ARRIVING
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum BillStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  NET_BANKING
}

// ── Models ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  mobile       String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  providerProfile  ProviderProfile?
  otps             Otp[]
  vehicles         Vehicle[]
  customerRequests ServiceRequest[] @relation("CustomerRequests")
  assignedRequests ServiceRequest[] @relation("ProviderRequests")
  customerBills    Bill[]           @relation("CustomerBills")
  providerBills    Bill[]           @relation("ProviderBills")
  customerPayments Payment[]        @relation("CustomerPayments")
  providerPayments Payment[]        @relation("ProviderPayments")
  customerRatings  Rating[]         @relation("CustomerRatings")
  providerRatings  Rating[]         @relation("ProviderRatings")
  deviceTokens     DeviceToken[]

  @@map("users")
}

model Vehicle {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // Bike, Car, Van, Auto, Bus, Light Commercial Vehicle, Heavy Vehicle
  manufacturer String
  model        String
  plateNumber  String
  year         String?
  color        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceRequests ServiceRequest[]

  @@map("vehicles")
}

model ProviderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           ProviderCategory   @default(MECHANIC)
  verificationStatus VerificationStatus @default(PENDING)
  availability       AvailabilityStatus @default(OFFLINE)

  garageName         String?
  businessAddress    String?
  serviceRadiusKm    Float              @default(25.0)
  latitude           Float?
  longitude          Float?
  rating             Float              @default(5.0)
  ratingCount        Int                @default(0)
  totalJobs          Int                @default(0)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("provider_profiles")
}

model ServiceRequest {
  id                 String           @id @default(uuid())
  customerId         String
  customer           User             @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  providerId         String?
  provider           User?            @relation("ProviderRequests", fields: [providerId], references: [id], onDelete: SetNull)

  category           ProviderCategory @default(MECHANIC)
  serviceType        String           // e.g. Mechanical Repair, Tyre & Puncture, Tow Truck, Battery, Fuel
  problemDescription String

  status             RequestStatus    @default(PENDING)

  customerLatitude   Float
  customerLongitude  Float
  customerAddress    String?

  vehicleId          String?
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehiclePlate       String
  vehicleModel       String
  vehicleType        String?

  estimatedAmount    Float?
  finalAmount        Float?
  cancellationReason String?

  pricingConfigId           String?
  pricingConfig             PricingConfig?   @relation(fields: [pricingConfigId], references: [id], onDelete: SetNull)
  estimateBreakdown         Json?
  revisedEstimateBreakdown  Json?

  acceptedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  bill               Bill?
  payments           Payment[]
  rating             Rating?

  @@index([customerId])
  @@index([providerId])
  @@index([status, category])
  @@map("service_requests")
}

model Bill {
  id              String     @id @default(uuid())
  requestId       String     @unique
  serviceRequest  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId      String
  provider        User       @relation("ProviderBills", fields: [providerId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User       @relation("CustomerBills", fields: [customerId], references: [id], onDelete: Cascade)

  status          BillStatus @default(PENDING)
  subtotal        Float
  taxRate         Float      @default(0.18) // 18% GST
  taxAmount       Float
  grandTotal      Float
  notes           String?
  rejectionReason String?

  items           BillItem[]
  payment         Payment?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([providerId])
  @@index([customerId])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float

  @@map("bill_items")
}

model Payment {
  id             String        @id @default(uuid())
  billId         String        @unique
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  requestId      String
  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User          @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Cascade)
  providerId     String
  provider       User          @relation("ProviderPayments", fields: [providerId], references: [id], onDelete: Cascade)

  amount         Float
  method         PaymentMethod @default(UPI)
  status         PaymentStatus @default(PENDING)
  transactionId  String        @unique
  receiptNumber  String?       @unique
  paidAt         DateTime?
  failureReason  String?

  gateway          String?       @default("RAZORPAY")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId])
  @@index([providerId])
  @@index([requestId])
  @@index([gatewayOrderId])
  @@map("payments")
}

model Rating {
  id             String         @id @default(uuid())
  requestId      String         @unique
  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User           @relation("CustomerRatings", fields: [customerId], references: [id], onDelete: Cascade)
  providerId     String
  provider       User           @relation("ProviderRatings", fields: [providerId], references: [id], onDelete: Cascade)

  score          Int            // 1 - 5 stars
  review         String?        // Optional written review text

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([providerId])
  @@index([customerId])
  @@map("ratings")
}

model Otp {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier  String     // Email or mobile number
  purpose     OtpPurpose
  otpHash     String     // Bcrypt hash of OTP value
  expiresAt   DateTime
  isUsed      Boolean    @default(false)
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  createdAt   DateTime   @default(now())

  @@index([identifier, purpose])
  @@map("otps")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String?  // ANDROID, IOS, WEB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model PricingConfig {
  id                 String           @id @default(uuid())
  category           ProviderCategory
  problemCategory    String?
  vehicleType        String?

  baseLaborCharge    Decimal          @db.Decimal(10, 2)
  perKmCharge        Decimal          @default(0.00) @db.Decimal(10, 2)
  includedDistanceKm Decimal          @default(0.00) @db.Decimal(10, 2)
  additionalCharges  Decimal          @default(0.00) @db.Decimal(10, 2)
  taxRate            Decimal          @default(0.18) @db.Decimal(5, 4)

  description        String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  serviceRequests    ServiceRequest[]

  @@index([category, vehicleType, isActive])
  @@index([category, problemCategory, vehicleType, isActive])
  @@map("pricing_configs")
}

